NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) or legacy anon JWT (eyJ...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
# Optional alias used by some Supabase Next.js templates:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Server-only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-or-secret-key

# Required for npm run sync:supabase (database migration apply)
# From Supabase Dashboard → Settings → Database → Database password
# SUPABASE_DB_PASSWORD=your-database-password
# Or full connection string:
# DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
